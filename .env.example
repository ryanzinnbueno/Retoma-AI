# Server-only. Keep the real key in the ignored .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server-only WhatsApp Cloud API credentials. Never expose these in client code.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1268172406387019
WHATSAPP_WABA_ID=2545415742569584
WHATSAPP_WORKSPACE_OWNER=retoma-principal
META_APP_ID=2577354159356046
META_APP_SECRET=
# Public ID created in Meta > WhatsApp > Embedded Signup configuration.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Base64 for exactly 32 random bytes. Used only on the server to encrypt customer tokens.
RETOMA_CREDENTIALS_KEY=
META_GRAPH_VERSION=v25.0

# Vercel frontend proxy. Use the same RETOMA_PROXY_SECRET in Cloudflare and Vercel.
RETOMA_APP_PASSWORD=
RETOMA_PROXY_SECRET=
RETOMA_WORKER_URL=https://retoma-ai.rogerio-ryan4057.workers.dev
